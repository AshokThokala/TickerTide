# Copy this file to backend/.env and fill in your keys from
# https://app.alpaca.markets (Paper Trading account -> API Keys). Never commit .env.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=

# Free (Basic) plan: IEX feed, up to 30 live symbols. On a paid plan use sip / raise the limit.
ALPACA_FEED=iex
ALPACA_MAX_SYMBOLS=30
